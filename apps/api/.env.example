DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance?schema=public"
# In production, DATABASE_URL may be omitted and composed from these values:
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_NAME="attendance"
DATABASE_USERNAME="attendance"
DATABASE_PASSWORD="attendance"
WEB_ORIGINS="http://localhost:5173"
PORT=3001
ALLOW_LEGACY_COGNITO_SUBJECTS="false"
SEED_TENANT_NAME="Example Organization"
SEED_TENANT_SLUG="example"
SEED_ADMIN_COGNITO_SUBJECT=""
SEED_ADMIN_EMAIL="admin@example.com"
SEED_IDENTITY_ISSUER="https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_example"
SEED_IDENTITY_CLIENT_ID="example-public-app-client-id"
SEED_IDENTITY_HOSTED_UI_DOMAIN="https://example.auth.ap-south-1.amazoncognito.com"
SEED_IDENTITY_MFA_POLICY="OPTIONAL"
# Optional deterministic local workflow data. Never enable this in production.
SEED_ATTENDANCE_DEMO="false"
SEED_ATTENDANCE_PERIOD_START="2026-08-01"
SEED_ATTENDANCE_PERIOD_END="2026-08-31"
SEED_POLICY_ENGINE_DEMO="false"
# Required by SAML onboarding. The bucket must use server-side encryption and block public access.
SAML_METADATA_BUCKET="attendance-saml-metadata-dev"
# Shared pools must be explicitly approved for tenant SAML providers.
SAML_SHARED_POOL_IDS="ap-south-1_example"
# Exact user-pool ARNs the API may configure and activate. Keep this resource-scoped.
IDENTITY_ADMIN_POOL_ARNS="arn:aws:cognito-idp:ap-south-1:123456789012:userpool/ap-south-1_example"
SAML_METADATA_MAX_BYTES="1048576"
SAML_FETCH_TIMEOUT_MS="10000"
# Local-only escape hatch for http://localhost IdP endpoints; rejected in production.
SAML_ALLOW_INSECURE_LOCALHOST="false"
API_JSON_BODY_LIMIT="256kb"
SCIM_RATE_LIMIT_PER_MINUTE="120"
# Private import/export object storage. LocalStack can be selected with AWS_ENDPOINT_URL.
IMPORT_BUCKET="attendance-imports-local"
EXPORT_BUCKET="attendance-exports-local"
PROCESSING_QUEUE_URL="http://sqs.ap-south-1.localhost.localstack.cloud:4566/000000000000/attendance-processing.fifo"
ATTENDANCE_IMPORT_MAX_BYTES="26214400"
ATTENDANCE_UPLOAD_EXPIRY_SECONDS="300"
PAYROLL_DOWNLOAD_EXPIRY_SECONDS="300"
# Optional canonical prefix. Defaults to the incoming HTTPS host.
# SCIM_PUBLIC_BASE_URL="https://attendance.example.com/api/v1/scim/v2"
# Bounds how far back a policy publish's effectiveFrom may be, to cap recompute job size.
POLICY_MAX_RECOMPUTE_DAYS="400"
# Lookback window for group-membership/priority-driven recomputes (memberships aren't
# effective-dated in this slice, so this bounds how far back a membership change reprocesses).
POLICY_RECOMPUTE_MEMBERSHIP_LOOKBACK_DAYS="60"
