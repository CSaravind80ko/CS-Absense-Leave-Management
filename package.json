{
  "name": "attendance-intelligence-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "infra"
  ],
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "npm run start:dev --workspace @attendance/api",
    "dev:worker": "npm run start:dev --workspace @attendance/worker",
    "build": "npm run build --workspace @attendance/contracts && npm run build:web && npm run build --workspace @attendance/api && npm run build --workspace @attendance/worker && npm run build --workspace @attendance/infra",
    "build:web": "tsc -b && vite build",
    "lint": "oxlint && npm run lint --workspace @attendance/api && npm run lint --workspace @attendance/worker",
    "test": "npm test --workspace @attendance/api && npm test --workspace @attendance/worker",
    "preview": "vite preview",
    "db:generate": "npm run prisma:generate --workspace @attendance/api",
    "db:migrate": "npm run prisma:migrate --workspace @attendance/api",
    "db:seed": "npm run prisma:seed --workspace @attendance/api",
    "e2e:local": "node scripts/e2e-local.mjs",
    "e2e:dev": "node scripts/e2e-dev.mjs",
    "deploy:dev": "node scripts/deploy-dev.mjs --stage dev",
    "infra:verify": "node scripts/verify-synth.mjs",
    "infra:diff": "npm run diff --workspace @attendance/infra",
    "infra:deploy": "npm run deploy --workspace @attendance/infra"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
